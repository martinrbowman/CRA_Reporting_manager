# Copy to .env and fill in real values. .env is gitignored — never commit it.
# scripts/start.sh will auto-generate a .env with random JWT_SECRET/DB_PASSWORD
# on first run if one doesn't exist yet.

# ── Application ────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
# DATABASE_URL is what the api container actually connects with (docker-compose
# passes it through as-is) — if you change DB_HOST/PORT/NAME/USER/PASSWORD,
# update DATABASE_URL to match, or point it at an external Postgres entirely.
DB_HOST=db
DB_PORT=5432
DB_NAME=cra_platform
DB_USER=cra_user
DB_PASSWORD=change-me
DATABASE_URL=postgresql://cra_user:change-me@db:5432/cra_platform

# Host port the web container is published on (Docker/Podman path only).
WEB_PORT=80

# ── Auth ───────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_EXPIRY=8h
REFRESH_TOKEN_EXPIRY=7d

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost

# ── CRA Art. 14 reporting (reserved for future regulator-API integration —
#    the platform currently exports a PDF for manual submission; leave empty) ──
CRA_REPORTING_BASE_URL=
CRA_ENISA_ENDPOINT=

# ── SMTP (optional — leave SMTP_HOST empty to disable email; notifications
#    are then recorded as manually-sent rather than actually delivered) ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cra-platform@example.com

# ── Admin bootstrap (used once by `pnpm --filter @cra/api db:seed`) ─────────
# Required — no default email is provided.
ADMIN_EMAIL=
# Optional — if unset, a random password is generated and printed once to
# stdout during seeding. Never set this to a fixed/shared value in production.
# ADMIN_PASSWORD=

# ── LDAP / AD ────────────────────────────────────────────────────────────────
# LDAP is configured via config/ldap.yml (copy from config/ldap.example.yml),
# not env vars — see that file. LDAP_CONFIG_PATH overrides its default path.
# LDAP_CONFIG_PATH=./config/ldap.yml
